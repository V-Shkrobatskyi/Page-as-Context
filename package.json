{
  "name": "page-as-context",
  "description": "Local browser extension for copying semantic page context in Chrome and Firefox.",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check:firefox-package": "node scripts/check-firefox-package.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:memory": "vitest run --config tests/memory/vitest.config.ts",
    "check": "npm run compile && npm test && npm run test:memory && npm run build && npm run build:firefox && npm run check:browser-builds && npm run lint:firefox",
    "check:desktop-runtime": "node scripts/check-desktop-runtime.mjs",
    "check:browser-builds": "node scripts/check-browser-builds.mjs",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/commonmark": "^0.27.10",
    "@types/jsdom": "^30.0.0",
    "commonmark": "^0.31.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "4.1.11",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=24.10.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "dependencies": {
    "re2js": "2.8.8"
  }
}
